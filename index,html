const apiKey = ""; 

// --- ENGINE SETUP ---
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d', { alpha: false });

// --- GAME STATE & UPGRADES ---
let coins = 0;
let level = 1;

// Upgrade State
let upgrades = {
    fireRate: 1, // Reduces spawn delay
    speed: 1,    // Increases mob speed
    income: 1    // Multiplies coin gain
};

// Costs
const COSTS = {
    fireRate: (lvl) => 100 * lvl,
    speed: (lvl) => 150 * lvl,
    income: (lvl) => 200 * lvl
};

// Configuration
let CONFIG = {
    baseSpawnRate: 8,
    baseMobSpeed: 4.5,
    playerSpeed: 0.15, 
    enemySpeed: 2.2, // Base enemy speed
    colors: {
        bgTop: '#00c6ff', bgBot: '#ffffff',
        floor1: '#f0f8ff', floor2: '#dceeff',
        friend: '#ffcc00', enemy: '#cc00cc',
        gateGood: '#00dd00', gateBad: '#ff0000'
    }
};

let gameState = 'MENU';
let width, height;
let frame = 0;
let bgOffset = 0;
let bgGradient = null;

// Entities
let playerX = 0;
let targetX = 0;
let mobs = [];
let enemies = [];
let gates = [];
let particles = [];
let enemyBase = { hp: 100, maxHp: 100, y: 0 };
let levelReward = 0;

// --- INITIALIZATION ---
window.addEventListener('load', () => {
    resize();
    initLevel(1); 
    updateShopUI();
    requestAnimationFrame(draw);
});

function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;
    if(gameState === 'MENU') {
        playerX = width / 2;
        targetX = width / 2;
    }
    bgGradient = ctx.createLinearGradient(0, 0, 0, height);
    bgGradient.addColorStop(0, CONFIG.colors.bgTop);
    bgGradient.addColorStop(1, CONFIG.colors.bgBot);
}
window.addEventListener('resize', resize);

// --- INPUT ---
function handleInput(x) {
    targetX = x;
    if(targetX < 40) targetX = 40;
    if(targetX > width - 40) targetX = width - 40;
}
window.addEventListener('mousemove', e => { if(gameState === 'PLAYING') handleInput(e.clientX); });
window.addEventListener('touchmove', e => { 
    if(gameState === 'PLAYING') { e.preventDefault(); handleInput(e.touches[0].clientX); } 
}, {passive: false});

// --- LEVEL GENERATION (INFINITE SCALING) ---
function initLevel(lvl) {
    mobs = [];
    enemies = [];
    particles = [];
    gates = [];
    frame = 0;
    
    // DIFFICULTY SCALING
    // HP scales exponentially
    const hp = Math.floor(100 + (lvl * 50) + Math.pow(lvl, 1.2) * 10);
    enemyBase = {
        hp: hp,
        maxHp: hp,
        y: 80, w: 140, h: 60
    };

    // Enemy Speed scales linearly
    CONFIG.enemySpeed = 2.0 + (lvl * 0.1); 
    if(CONFIG.enemySpeed > 5) CONFIG.enemySpeed = 5; // Cap speed

    const yStart = height - 350;
    
    // PROCEDURAL GATE GENERATION
    if (lvl === 1) {
        // Tutorial Level
        gates.push({ x: width*0.25, y: yStart, w: width*0.22, h: 60, type: 'mult', val: 2, vx: 0.5 });
        gates.push({ x: width*0.75, y: yStart, w: width*0.22, h: 60, type: 'mult', val: 3, vx: -0.5 });
    } else {
        // Infinite Generation
        const rowCount = Math.min(3, 1 + Math.floor(lvl / 3)); // More rows as you advance
        
        for(let r=0; r<rowCount; r++) {
            const rowY = yStart - (r * 250);
            const gateCount = 2 + (r % 2); // 2 or 3 gates per row
            
            for(let i=0; i<gateCount; i++) {
                const isBad = Math.random() < (0.1 + (lvl * 0.02)); // Chance of bad gate increases
                const type = (Math.random() > 0.5 && !isBad) ? 'mult' : 'add';
                
                // Value scaling
                let val;
                if(type === 'mult') val = 2 + Math.floor(Math.random() * (1 + lvl/5));
                else val = 5 + Math.floor(Math.random() * (10 + lvl * 2));
                
                // Bad gate logic
                if(isBad) {
                    val = -val; // Negative value
                }

                gates.push({
                    x: (width / (gateCount+1)) * (i+1),
                    y: rowY,
                    w: width * (0.8 / gateCount),
                    h: 60,
                    type: type,
                    val: val,
                    vx: (Math.random() - 0.5) * (1 + lvl * 0.2) // Speed increases
                });
            }
        }
    }
}

// --- SHOP LOGIC ---
function updateShopUI() {
    document.getElementById('shopCoinDisplay').innerText = coins;
    document.getElementById('coinDisplay').innerText = coins;

    // Fire Rate
    const cFire = COSTS.fireRate(upgrades.fireRate);
    const btnFire = document.getElementById('buyFireRate');
    btnFire.innerText = `Lvl ${upgrades.fireRate} - ${cFire}💰`;
    btnFire.className = coins >= cFire ? 'upgrade-btn' : 'upgrade-btn disabled';

    // Speed
    const cSpeed = COSTS.speed(upgrades.speed);
    const btnSpeed = document.getElementById('buySpeed');
    btnSpeed.innerText = `Lvl ${upgrades.speed} - ${cSpeed}💰`;
    btnSpeed.className = coins >= cSpeed ? 'upgrade-btn' : 'upgrade-btn disabled';

    // Income
    const cInc = COSTS.income(upgrades.income);
    const btnInc = document.getElementById('buyIncome');
    btnInc.innerText = `Lvl ${upgrades.income} - ${cInc}💰`;
    btnInc.className = coins >= cInc ? 'upgrade-btn' : 'upgrade-btn disabled';
}

function buyUpgrade(type) {
    const cost = COSTS[type](upgrades[type]);
    if(coins >= cost) {
        coins -= cost;
        upgrades[type]++;
        updateShopUI();
    }
}

// Apply Upgrades to Gameplay Stats
function getEffectiveStats() {
    // Fire Rate: Lower spawnRate is better. Base 8, min 2.
    // Each level reduces delay by 0.5
    const spawnRate = Math.max(2, CONFIG.baseSpawnRate - (upgrades.fireRate - 1) * 0.5);
    
    // Speed: Base 4.5, +0.2 per level
    const mobSpeed = CONFIG.baseMobSpeed + (upgrades.speed - 1) * 0.5;

    return { spawnRate, mobSpeed };
}


// --- UPDATE LOOP ---
function update() {
    if(gameState !== 'PLAYING') return;
    frame++;
    bgOffset += 4; 

    const stats = getEffectiveStats();

    playerX += (targetX - playerX) * CONFIG.playerSpeed;

    // Player Spawn (With Upgraded Rate)
    // Using simple modulo logic, might need floor for non-integers
    if(frame % Math.floor(stats.spawnRate) === 0) {
        mobs.push(createMob(playerX, height - 100, false));
    }

    // Enemy Spawn (Waves increase with Level)
    const waveRate = Math.max(15, 60 - (level * 2));
    if(frame % waveRate === 0) {
        // Spawn multiple enemies at higher levels
        const count = 1 + Math.floor(level / 5);
        for(let i=0; i<count; i++) {
             enemies.push(createMob(width/2 + (Math.random()-0.5)*120, enemyBase.y + 60, true));
        }
    }

    // Move Gates
    gates.forEach(g => {
        g.x += g.vx;
        if(g.x > width - g.w/2 || g.x < g.w/2) g.vx *= -1;
    });

    // Mobs Logic
    for(let i = mobs.length - 1; i >= 0; i--) {
        let m = mobs[i];
        m.y -= stats.mobSpeed;
        m.x += m.vx;
        m.anim += 0.2;

        // Gate Logic
        let hitGate = false;
        for (let g of gates) {
            if (m.y < g.y + g.h/2 && m.y > g.y - g.h/2 && m.x > g.x - g.w/2 && m.x < g.x + g.w/2 && m.y > g.y) {
                hitGate = true;
                
                // Logic for Negative/Positive gates
                if (g.val > 0) {
                    // Positive: Multiply or Add
                    let count = (g.type === 'mult') ? (g.val - 1) : g.val;
                    count = Math.min(count, 50); // Cap
                    for(let k=0; k<count; k++) mobs.push(createMob(m.x, m.y - 20, false));
                    if(particles.length < 50) createParticle(g.x, g.y, '#fff', 2);
                } else {
                    // Negative: Kill mobs
                    // We remove THIS mob, plus maybe more if value is very negative?
                    // For simplicity in this engine, negative gate just kills the passing mob
                    // To make it harder, maybe a negative gate has a 'counter' but here we just kill the toucher.
                    // Visual effect: Red particles
                     if(particles.length < 50) createParticle(g.x, g.y, '#f00', 2);
                }
                break;
            }
        }
        
        if(hitGate) m.y -= 30; // Push past gate

        // Combat
        let hitEnemy = false;
        for(let eIdx = enemies.length - 1; eIdx >= 0; eIdx--) {
            let e = enemies[eIdx];
            if(Math.hypot(m.x - e.x, m.y - e.y) < 15) {
                hitEnemy = true;
                enemies.splice(eIdx, 1);
                // Coin Chance on kill
                if(Math.random() < 0.1) coins += (1 * upgrades.income);
                
                if(particles.length < 50) particles.push(createParticle(m.x, m.y, '#fff'));
                break;
            }
        }

        // Base Damage
        if(m.y < enemyBase.y + enemyBase.h && Math.abs(m.x - width/2) < enemyBase.w/2 + 20) {
            enemyBase.hp--;
            hitEnemy = true;
            // Coin Chance on Damage
            if(Math.random() < 0.3) coins += (1 * upgrades.income);

            if(enemyBase.hp <= 0) {
                // WIN
                gameState = 'WIN';
                // Level Completion Reward
                levelReward = 50 + (level * 10) * upgrades.income;
                coins += levelReward;
                
                document.getElementById('winCoins').innerText = levelReward;
                document.getElementById('coinDisplay').innerText = coins;
                
                spawnConfetti();
                document.getElementById('win-screen').classList.remove('hidden');
                document.getElementById('game-hud').classList.add('hidden');
            }
        }

        if(hitEnemy || m.y < -50) mobs.splice(i, 1);
    }

    // Enemies Logic
    for(let i = enemies.length - 1; i >= 0; i--) {
        let e = enemies[i];
        e.y += CONFIG.enemySpeed;
        e.x += e.vx;
        e.anim += 0.2;

        if(e.y > height - 50) {
            // LOSE
            gameState = 'GAMEOVER';
            levelReward = Math.floor((10 + level) * upgrades.income); // Pity coins
            coins += levelReward;
            
            document.getElementById('loseCoins').innerText = levelReward;
            document.getElementById('coinDisplay').innerText = coins;
            
            document.getElementById('game-over-screen').classList.remove('hidden');
            document.getElementById('game-hud').classList.add('hidden');
        }
    }

    // Particles
    for(let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life -= p.decay;
        if(p.life <= 0) particles.splice(i, 1);
    }

    document.getElementById('armyCount').innerText = mobs.length;
    document.getElementById('coinDisplay').innerText = Math.floor(coins);
}

// --- RENDERING & FACTORIES (Same as previous, omitted for brevity but included in file) ---
function createMob(x, y, isEnemy) {
    return { x: x + (Math.random()-0.5)*20, y: y, vx: (Math.random()-0.5)*1.5, radius: 6, isEnemy: isEnemy, anim: Math.random()*10 };
}
function createParticle(x, y, color, speed=1) {
    const a = Math.random()*Math.PI*2, v = Math.random()*5*speed;
    return { x:x, y:y, vx:Math.cos(a)*v, vy:Math.sin(a)*v, life:1.0, color:color, decay:0.02+Math.random()*0.03 };
}
function spawnConfetti() { for(let i=0; i<60; i++) particles.push(createParticle(width/2, height/2, `hsl(${Math.random()*360}, 100%, 50%)`, 3)); }

function drawStickman(x, y, isEnemy, anim) {
    const color = isEnemy ? CONFIG.colors.enemy : CONFIG.colors.friend;
    const legSwing = Math.sin(anim) * 5;
    ctx.fillStyle = color;
    ctx.beginPath(); ctx.arc(x, y - 5, 8, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = color; ctx.lineWidth = 5; ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x - 4, y + 2); ctx.lineTo(x - 5, y + 10 + legSwing);
    ctx.moveTo(x + 4, y + 2); ctx.lineTo(x + 5, y + 10 - legSwing);
    ctx.moveTo(x - 6, y - 5); ctx.lineTo(x - 10, y + legSwing);
    ctx.moveTo(x + 6, y - 5); ctx.lineTo(x + 10, y - legSwing);
    ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.beginPath(); ctx.arc(x - 3, y - 8, 2, 0, Math.PI*2); ctx.fill();
}

function draw() {
    if(!width || !height) return requestAnimationFrame(draw);
    if(bgGradient) { ctx.fillStyle = bgGradient; ctx.fillRect(0, 0, width, height); }
    
    // Floor
    const gridSize = 80;
    const offsetY = bgOffset % (gridSize * 2);
    for(let y = -gridSize; y < height; y += gridSize) {
        const adjustedY = y + offsetY;
        if(adjustedY > -gridSize && adjustedY < height) {
            const isStripe = Math.floor((y + bgOffset) / gridSize) % 2 === 0;
            ctx.fillStyle = isStripe ? CONFIG.colors.floor1 : CONFIG.colors.floor2;
            ctx.fillRect(0, adjustedY, width, gridSize);
        }
    }

    // Gates
    gates.forEach(g => {
        const isGood = g.val > 0;
        const color = isGood ? CONFIG.colors.gateGood : CONFIG.colors.gateBad;
        
        ctx.fillStyle = isGood ? 'rgba(0, 221, 0, 0.2)' : 'rgba(255, 0, 0, 0.2)';
        ctx.fillRect(g.x - g.w/2, g.y - g.h/2, g.w, g.h);
        ctx.strokeStyle = color; ctx.lineWidth = 4; ctx.strokeRect(g.x - g.w/2, g.y - g.h/2, g.w, g.h);
        ctx.fillStyle = '#fff';
        ctx.fillRect(g.x - g.w/2 - 5, g.y - g.h/2 - 10, 10, g.h + 20);
        ctx.fillRect(g.x + g.w/2 - 5, g.y - g.h/2 - 10, 10, g.h + 20);

        ctx.fillStyle = '#fff'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        let emoji = isGood ? '😇' : '😈';
        let txt = g.type === 'mult' ? "×" + Math.abs(g.val) : ((g.val > 0 ? "+" : "") + g.val);
        
        ctx.font = '40px Arial'; ctx.fillText(emoji, g.x, g.y - 15);
        ctx.fillStyle = color; ctx.font = '900 28px Arial'; ctx.lineWidth = 2; ctx.strokeStyle = 'white';
        ctx.strokeText(txt, g.x, g.y + 20); ctx.fillText(txt, g.x, g.y + 20);
    });

    // Base
    ctx.fillStyle = '#440044'; ctx.fillRect(width/2 - enemyBase.w/2, enemyBase.y, enemyBase.w, enemyBase.h);
    const hpPercent = Math.max(0, enemyBase.hp / enemyBase.maxHp);
    ctx.fillStyle = '#333'; ctx.fillRect(width/2 - enemyBase.w/2, enemyBase.y - 25, enemyBase.w, 12);
    ctx.fillStyle = hpPercent > 0.5 ? '#00dd00' : '#dd0000'; ctx.fillRect(width/2 - enemyBase.w/2, enemyBase.y - 25, enemyBase.w * hpPercent, 12);

    mobs.forEach(m => drawStickman(m.x, m.y, false, m.anim));
    enemies.forEach(e => drawStickman(e.x, e.y, true, e.anim));

    // Player
    ctx.fillStyle = 'rgba(0,0,0,0.2)'; ctx.beginPath(); ctx.ellipse(playerX, height - 70, 25, 10, 0, 0, Math.PI*2); ctx.fill();
    let pGrad = ctx.createRadialGradient(playerX - 10, height - 90, 5, playerX, height - 80, 30);
    pGrad.addColorStop(0, '#ffffaa'); pGrad.addColorStop(0.3, CONFIG.colors.friend); pGrad.addColorStop(1, '#cc9900');
    ctx.fillStyle = pGrad; ctx.beginPath(); ctx.arc(playerX, height - 80, 25, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.6)'; ctx.beginPath(); ctx.ellipse(playerX - 10, height - 95, 8, 4, Math.PI/4, 0, Math.PI*2); ctx.fill();

    particles.forEach(p => { ctx.globalAlpha = p.life; ctx.fillStyle = p.color; ctx.beginPath(); ctx.arc(p.x, p.y, 4, 0, Math.PI*2); ctx.fill(); });
    ctx.globalAlpha = 1.0;

    if(gameState === 'PLAYING') requestAnimationFrame(update);
    requestAnimationFrame(draw);
}

// --- EVENT LISTENERS ---
document.getElementById('startBtn').addEventListener('click', () => {
    document.getElementById('start-screen').classList.add('hidden');
    document.getElementById('game-hud').classList.remove('hidden');
    gameState = 'PLAYING';
    update();
});
document.getElementById('nextLevelBtn').addEventListener('click', () => {
    document.getElementById('win-screen').classList.add('hidden');
    document.getElementById('game-hud').classList.remove('hidden');
    level++;
    document.getElementById('levelDisplay').innerText = "LVL " + level;
    initLevel(level);
    gameState = 'PLAYING';
    update();
});
document.getElementById('restartBtn').addEventListener('click', () => {
    document.getElementById('game-over-screen').classList.add('hidden');
    document.getElementById('game-hud').classList.remove('hidden');
    initLevel(level);
    gameState = 'PLAYING';
    update();
});

// Shop Button Listeners
const openShop = () => {
    document.getElementById('start-screen').classList.add('hidden');
    document.getElementById('win-screen').classList.add('hidden');
    document.getElementById('game-over-screen').classList.add('hidden');
    document.getElementById('shop-screen').classList.remove('hidden');
    updateShopUI();
};
document.getElementById('shopBtn').addEventListener('click', openShop);
document.getElementById('shopBtnWin').addEventListener('click', openShop);
document.getElementById('shopBtnLose').addEventListener('click', openShop);

document.getElementById('shopCloseBtn').addEventListener('click', () => {
    document.getElementById('shop-screen').classList.add('hidden');
    // Return to previous screen context roughly
    if(gameState === 'MENU') document.getElementById('start-screen').classList.remove('hidden');
    else if(gameState === 'WIN') document.getElementById('win-screen').classList.remove('hidden');
    else if(gameState === 'GAMEOVER') document.getElementById('game-over-screen').classList.remove('hidden');
});

document.getElementById('buyFireRate').addEventListener('click', () => buyUpgrade('fireRate'));
document.getElementById('buySpeed').addEventListener('click', () => buyUpgrade('speed'));
document.getElementById('buyIncome').addEventListener('click', () => buyUpgrade('income'));

</script>
